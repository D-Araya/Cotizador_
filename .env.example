# Gemini API Key (Server-side proxy routes)
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash

# Authentication & Session
SESSION_SECRET=
ADMIN_KEY=

# Persistence Backend ('memory' or 'firestore')
DATA_BACKEND=memory

# SMTP Configuration (Optional, for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
